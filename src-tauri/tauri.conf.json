{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FCS Manager",
  "version": "0.1.0",
  "identifier": "com.pkheisig.fcs-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FCS Manager",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app_icon.png",
      "icons/AppIcon.icns"
    ]
  }
}
